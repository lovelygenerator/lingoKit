cli-arg-lang = 表示言語(例: en, ja)
cli-arg-help = ヘルプを表示する
cli-arg-help-long = ヘルプを表示する(-h で概要のみ表示)
cli-arg-version = バージョンを表示する
cli-help-about = このメッセージ、または指定したサブコマンドのヘルプを表示する
cli-help-arg-subcommand = ヘルプを表示するサブコマンド

cli-heading-usage = 使い方
cli-heading-arguments = 引数
cli-heading-options = オプション
cli-heading-commands = コマンド
cli-label-possible-values = 指定できる値
cli-label-default = 既定値

cli-error-label = エラー
cli-error-hint = 詳しくは '--help' を参照してください。
cli-error-invalid-value = '{ $arg }' の値 '{ $value }' は不正です(指定できる値: { $valid_values })
cli-error-unknown-argument = 想定外の引数 '{ $arg }' があります
cli-error-missing-required-argument = 必須の引数が指定されていません: { $arg }
cli-error-invalid-subcommand = 不明なサブコマンド '{ $subcommand }' です
cli-error-argument-conflict = 引数 '{ $arg }' はここでは使えません
cli-error-no-equals = '{ $arg }' に値を指定するには '=' が必要です
cli-error-value-validation = '{ $arg }' の値 '{ $value }' は不正です
cli-error-too-many-values = '{ $arg }' に想定外の値 '{ $value }' があります
