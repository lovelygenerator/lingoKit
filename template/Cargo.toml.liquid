[workspace]
resolver = "3"
members = ["crates/*"]

[workspace.package]
version = "0.1.0"
edition = "2024"
rust-version = "1.88"

[workspace.dependencies]
core_lib = { package = "{{project-name}}-core", path = "crates/core" }

lingokit = { git = "{{lingokit_git}}" }
lingokit-build = { git = "{{lingokit_git}}" }

clap = { version = "4.6", features = ["derive"] }
rmcp = { version = "~3.10", features = ["server", "macros", "transport-io"] }
schemars = "1"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
thiserror = "2"
tokio = { version = "1", features = ["macros", "rt-multi-thread", "io-std"] }
